@startuml SubmitNewPasswordFlow

title Luồng Đặt Lại Mật Khẩu (Sử dụng OTP)

actor Client
participant AuthController
participant IAuthService
participant IUserRepository
participant ITokenService
participant "IPasswordHasher<User>" as IPasswordHasher
database ApplicationDBContext

Client -> AuthController: PATCH /api/auth/forgot_password (email, token, newPassword, repeatPassword)
activate AuthController

AuthController -> AuthController: Kiểm tra newPassword == repeatPassword
alt Mật khẩu không khớp
    AuthController --> Client: 400 Bad Request (Mật khẩu lặp lại không khớp)
    deactivate AuthController
else Mật khẩu khớp
    AuthController -> IAuthService: ForgotPassword(token, email, newPassword)
    activate IAuthService

    IAuthService -> IUserRepository: GetByEmailAsync(email)
    activate IUserRepository
    IUserRepository --> IAuthService: user (nếu tồn tại)
    deactivate IUserRepository

    alt Người dùng không tồn tại
        IAuthService --> AuthController: Exception("Người dùng không tồn tại.")
        deactivate IAuthService
        ' AuthController bắt exception và trả về BadRequest
        AuthController --> Client: 400 Bad Request (Đổi mật khẩu thất bại.)
        deactivate AuthController
    else Người dùng tồn tại
        IAuthService -> ITokenService: VerifyTokenAsync(user.Id, token)
        activate ITokenService
        ITokenService --> IAuthService: isTokenValid (boolean)
        deactivate ITokenService

        alt Token không hợp lệ
            IAuthService --> AuthController: Exception("Token không hợp lệ.")
            deactivate IAuthService
            ' AuthController bắt exception và trả về BadRequest
            AuthController --> Client: 400 Bad Request (Đổi mật khẩu thất bại.)
            deactivate AuthController
        else Token hợp lệ
            IAuthService -> IPasswordHasher: HashPassword(user, newPassword)
            activate IPasswordHasher
            IPasswordHasher --> IAuthService: hashedPassword
            deactivate IPasswordHasher

            IAuthService -> ITokenService: RevokeAllUserOTP(user.Id)
            activate ITokenService
            ITokenService --> IAuthService: thành công (vô hiệu hóa OTP đã dùng)
            deactivate ITokenService

            IAuthService -> IUserRepository: Update(user with new password) & SaveChangesAsync()
            activate IUserRepository
            IUserRepository --> IAuthService: thành công
            deactivate IUserRepository

            IAuthService --> AuthController: true
            deactivate IAuthService
            AuthController --> Client: 200 OK (Đổi mật khẩu thành công.)
            deactivate AuthController
        end
    end
end

@enduml


@startuml ResetPasswordFlow

title Luồng Đặt Lại Mật Khẩu (Sử dụng Access Token)

actor Client
participant AuthController
participant IAuthService
participant IUserRepository
participant "IPasswordHasher<User>" as IPasswordHasher
database ApplicationDBContext

note over Client, AuthController
  Người dùng đã đăng nhập và có Access Token hợp lệ.
end note

Client -> AuthController: PATCH /api/auth/reset_password (Authorization: Bearer <AccessToken>, newPassword)
activate AuthController

AuthController -> AuthController: Trích xuất UserId từ Access Token
alt UserId không hợp lệ từ token
    AuthController --> Client: 401 Unauthorized (Không thể xác định người dùng)
    deactivate AuthController
else UserId hợp lệ
    AuthController -> IAuthService: ResetPassword(userId, newPassword)
    activate IAuthService

    IAuthService -> IUserRepository: GetByIdAsync(userId)
    activate IUserRepository
    IUserRepository --> IAuthService: user (nếu tồn tại)
    deactivate IUserRepository

    alt Người dùng không tồn tại
        IAuthService --> AuthController: Exception("Người dùng không tồn tại.")
        deactivate IAuthService
        ' AuthController bắt exception và trả về BadRequest
        AuthController --> Client: 400 Bad Request (Đổi mật khẩu thất bại.)
        deactivate AuthController
    else Người dùng tồn tại
        IAuthService -> IPasswordHasher: HashPassword(user, newPassword)
        activate IPasswordHasher
        IPasswordHasher --> IAuthService: hashedPassword
        deactivate IPasswordHasher

        IAuthService -> IUserRepository: Update(user with new password) & SaveChangesAsync()
        activate IUserRepository
        IUserRepository --> IAuthService: thành công
        deactivate IUserRepository

        IAuthService --> AuthController: true
        deactivate IAuthService
        AuthController --> Client: 200 OK (Đổi mật khẩu thành công.)
        deactivate AuthController
    end
end

@enduml
